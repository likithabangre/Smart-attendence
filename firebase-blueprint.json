{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user profiles for students and teachers",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher"] },
        "studentId": { "type": "string" },
        "department": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role", "createdAt"]
    },
    "Class": {
      "title": "Class",
      "description": "Academic classes created by teachers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "teacherId": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "teacherId", "createdAt"]
    },
    "AttendanceSession": {
      "title": "Attendance Session",
      "description": "Active session for taking attendance with a QR code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "teacherId": { "type": "string" },
        "qrCode": { "type": "string" },
        "expiresAt": { "type": "number" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "teacherId", "qrCode", "expiresAt", "createdAt"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Record of a student's attendance in a session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "classId": { "type": "string" },
        "studentId": { "type": "string" },
        "name": { "type": "string" },
        "studentIdNumber": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        }
      },
      "required": ["sessionId", "classId", "studentId", "name", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/classes/{classId}": {
      "schema": "Class",
      "description": "Class information"
    },
    "/sessions/{sessionId}": {
      "schema": "AttendanceSession",
      "description": "Active attendance sessions"
    },
    "/attendance/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Attendance history records"
    }
  }
}
